<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" id="Definitions_WorkpieceLifecycle" targetNamespace="https://virtual-factory.example/bpmn" exporter="Virtual Factory" exporterVersion="1.0">
<bpmn:process id="WorkpieceLifecycle" name="Workpiece lifecycle (MES)" isExecutable="true" operaton:historyTimeToLive="P1D">
<bpmn:documentation>One instance per workpiece (business key = serial number). Message events are correlated by the MES from the UNS events part_released, part_inspected and part_sorted. Procedure model of the master recipe MR-PC3280 (ManufacturingRecipe/Procedure/ProcedureModel).</bpmn:documentation>
<bpmn:startEvent id="Start_PartReleased" name="Part released by AC01"><bpmn:outgoing>Flow_1</bpmn:outgoing><bpmn:messageEventDefinition id="Start_PartReleased_def" messageRef="Msg_PartReleased" /></bpmn:startEvent><bpmn:serviceTask id="Task_CreateWorkpieceAas" name="Create workpiece AAS (OP10-OP70)" operaton:type="external" operaton:topic="workpiece-create"><bpmn:documentation>Creates the instance AAS from the blueprint: nameplate, DPP metadata, executed processes OP10-OP70 with the test data reported by the assembly cell.</bpmn:documentation><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:serviceTask><bpmn:eventBasedGateway id="Gw_WaitInspection"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:eventBasedGateway><bpmn:intermediateCatchEvent id="Catch_PartInspected" name="Part inspected (QS01)"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing><bpmn:messageEventDefinition id="Catch_PartInspected_def" messageRef="Msg_PartInspected" /></bpmn:intermediateCatchEvent><bpmn:intermediateCatchEvent id="Timer_InspectionTimeout" name="5 min"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_12</bpmn:outgoing><bpmn:timerEventDefinition id="Timer_InspectionTimeout_def"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT5M</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:intermediateCatchEvent><bpmn:serviceTask id="Task_RecordInspection" name="Record inspection (OP75, OP80)" operaton:type="external" operaton:topic="workpiece-record-inspection"><bpmn:documentation>Adds transport and colour inspection to the executed processes, writes QualityInspection and the measurement values, evaluates the verdict against the recipe limits.</bpmn:documentation><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:serviceTask><bpmn:eventBasedGateway id="Gw_WaitSorting"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing><bpmn:outgoing>Flow_8</bpmn:outgoing></bpmn:eventBasedGateway><bpmn:intermediateCatchEvent id="Catch_PartSorted" name="Part sorted (RB01)"><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_9</bpmn:outgoing><bpmn:messageEventDefinition id="Catch_PartSorted_def" messageRef="Msg_PartSorted" /></bpmn:intermediateCatchEvent><bpmn:intermediateCatchEvent id="Timer_SortingTimeout" name="5 min"><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:outgoing>Flow_13</bpmn:outgoing><bpmn:timerEventDefinition id="Timer_SortingTimeout_def"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT5M</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:intermediateCatchEvent><bpmn:serviceTask id="Task_RecordPacking" name="Record packing, location and PCF (OP90)" operaton:type="external" operaton:topic="workpiece-record-packing"><bpmn:documentation>Completes the run (OP90), sets the asset location (KLT and slot), adds the part to the KLT contents and writes the instance carbon footprint. Sets correctContainer.</bpmn:documentation><bpmn:incoming>Flow_9</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="Gw_Destination" name="Correct container?" default="Flow_Missorted"><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_Correct</bpmn:outgoing><bpmn:outgoing>Flow_Missorted</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:endEvent id="End_Completed" name="Part completed"><bpmn:incoming>Flow_Correct</bpmn:incoming></bpmn:endEvent><bpmn:serviceTask id="Task_MarkLost" name="Mark part as lost" operaton:type="external" operaton:topic="workpiece-mark-lost"><bpmn:documentation>The part did not reach the next station in time (tracking lost or removed): run result Aborted.</bpmn:documentation><bpmn:incoming>Flow_12</bpmn:incoming><bpmn:incoming>Flow_13</bpmn:incoming><bpmn:outgoing>Flow_14</bpmn:outgoing></bpmn:serviceTask><bpmn:endEvent id="End_Lost" name="Part lost"><bpmn:incoming>Flow_14</bpmn:incoming></bpmn:endEvent><bpmn:userTask id="User_CheckMissort" name="Check mis-sorted part" operaton:candidateGroups="operators"><bpmn:documentation>The part was placed into the wrong KLT. Remove it from KLT ${container} and re-sort manually.</bpmn:documentation><bpmn:incoming>Flow_Missorted</bpmn:incoming><bpmn:outgoing>Flow_11</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="End_Missorted" name="Mis-sort handled"><bpmn:incoming>Flow_11</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_1" sourceRef="Start_PartReleased" targetRef="Task_CreateWorkpieceAas"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_2" sourceRef="Task_CreateWorkpieceAas" targetRef="Gw_WaitInspection"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_3" sourceRef="Gw_WaitInspection" targetRef="Catch_PartInspected"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_4" sourceRef="Gw_WaitInspection" targetRef="Timer_InspectionTimeout"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_5" sourceRef="Catch_PartInspected" targetRef="Task_RecordInspection"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_6" sourceRef="Task_RecordInspection" targetRef="Gw_WaitSorting"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_7" sourceRef="Gw_WaitSorting" targetRef="Catch_PartSorted"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_8" sourceRef="Gw_WaitSorting" targetRef="Timer_SortingTimeout"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_9" sourceRef="Catch_PartSorted" targetRef="Task_RecordPacking"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_10" sourceRef="Task_RecordPacking" targetRef="Gw_Destination"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_Correct" name="yes" sourceRef="Gw_Destination" targetRef="End_Completed"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${correctContainer}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_Missorted" name="no" sourceRef="Gw_Destination" targetRef="User_CheckMissort"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_11" sourceRef="User_CheckMissort" targetRef="End_Missorted"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_12" sourceRef="Timer_InspectionTimeout" targetRef="Task_MarkLost"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_13" sourceRef="Timer_SortingTimeout" targetRef="Task_MarkLost"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_14" sourceRef="Task_MarkLost" targetRef="End_Lost"></bpmn:sequenceFlow>
</bpmn:process>
<bpmn:message id="Msg_PartReleased" name="PartReleased" /><bpmn:message id="Msg_PartInspected" name="PartInspected" /><bpmn:message id="Msg_PartSorted" name="PartSorted" />
<bpmndi:BPMNDiagram id="Diagram_WorkpieceLifecycle"><bpmndi:BPMNPlane id="Plane_WorkpieceLifecycle" bpmnElement="WorkpieceLifecycle">
<bpmndi:BPMNShape id="Start_PartReleased_di" bpmnElement="Start_PartReleased"><dc:Bounds x="160" y="182" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="140" y="222" width="76" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_CreateWorkpieceAas_di" bpmnElement="Task_CreateWorkpieceAas"><dc:Bounds x="250" y="160" width="110" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Gw_WaitInspection_di" bpmnElement="Gw_WaitInspection"><dc:Bounds x="410" y="175" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Catch_PartInspected_di" bpmnElement="Catch_PartInspected"><dc:Bounds x="510" y="182" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="490" y="222" width="76" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="Timer_InspectionTimeout_di" bpmnElement="Timer_InspectionTimeout"><dc:Bounds x="510" y="312" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="490" y="352" width="76" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_RecordInspection_di" bpmnElement="Task_RecordInspection"><dc:Bounds x="600" y="160" width="110" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Gw_WaitSorting_di" bpmnElement="Gw_WaitSorting"><dc:Bounds x="760" y="175" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Catch_PartSorted_di" bpmnElement="Catch_PartSorted"><dc:Bounds x="860" y="182" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="840" y="222" width="76" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="Timer_SortingTimeout_di" bpmnElement="Timer_SortingTimeout"><dc:Bounds x="860" y="312" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="840" y="352" width="76" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_RecordPacking_di" bpmnElement="Task_RecordPacking"><dc:Bounds x="950" y="160" width="110" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Gw_Destination_di" bpmnElement="Gw_Destination" isMarkerVisible="true"><dc:Bounds x="1110" y="175" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1085" y="140" width="90" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="End_Completed_di" bpmnElement="End_Completed"><dc:Bounds x="1220" y="182" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1200" y="222" width="76" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_MarkLost_di" bpmnElement="Task_MarkLost"><dc:Bounds x="950" y="290" width="110" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="End_Lost_di" bpmnElement="End_Lost"><dc:Bounds x="987" y="410" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1030" y="418" width="76" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="User_CheckMissort_di" bpmnElement="User_CheckMissort"><dc:Bounds x="1190" y="400" width="110" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="End_Missorted_di" bpmnElement="End_Missorted"><dc:Bounds x="1350" y="422" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1330" y="462" width="76" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="196" y="200" /><di:waypoint x="250" y="200" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="360" y="200" /><di:waypoint x="410" y="200" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="460" y="200" /><di:waypoint x="510" y="200" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4"><di:waypoint x="435" y="225" /><di:waypoint x="435" y="330" /><di:waypoint x="510" y="330" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5"><di:waypoint x="546" y="200" /><di:waypoint x="600" y="200" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6"><di:waypoint x="710" y="200" /><di:waypoint x="760" y="200" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7"><di:waypoint x="810" y="200" /><di:waypoint x="860" y="200" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8"><di:waypoint x="785" y="225" /><di:waypoint x="785" y="330" /><di:waypoint x="860" y="330" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9"><di:waypoint x="896" y="200" /><di:waypoint x="950" y="200" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10"><di:waypoint x="1060" y="200" /><di:waypoint x="1110" y="200" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_Correct_di" bpmnElement="Flow_Correct"><di:waypoint x="1160" y="200" /><di:waypoint x="1220" y="200" /><bpmndi:BPMNLabel><dc:Bounds x="1166" y="182" width="60" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_Missorted_di" bpmnElement="Flow_Missorted"><di:waypoint x="1135" y="225" /><di:waypoint x="1135" y="440" /><di:waypoint x="1190" y="440" /><bpmndi:BPMNLabel><dc:Bounds x="1141" y="207" width="60" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11"><di:waypoint x="1300" y="440" /><di:waypoint x="1350" y="440" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_12_di" bpmnElement="Flow_12"><di:waypoint x="528" y="348" /><di:waypoint x="528" y="390" /><di:waypoint x="970" y="390" /><di:waypoint x="970" y="370" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_13_di" bpmnElement="Flow_13"><di:waypoint x="896" y="330" /><di:waypoint x="950" y="330" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_14_di" bpmnElement="Flow_14"><di:waypoint x="1005" y="370" /><di:waypoint x="1005" y="410" /></bpmndi:BPMNEdge>
</bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>
