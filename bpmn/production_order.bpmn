<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" id="Definitions_ProductionOrder" targetNamespace="https://virtual-factory.example/bpmn" exporter="Virtual Factory" exporterVersion="1.0">
<bpmn:process id="ProductionOrder" name="Production order (MES)" isExecutable="true" operaton:historyTimeToLive="P1D">
<bpmn:documentation>Production order on LINE01, released by the ERP (message OrderReleased, business key = order number) or started manually in Tasklist: starts the line through the AAS (LineControl operations, delegated to the ops gateway), follows the progress in the AAS and handles high reject rates and full KLTs with user tasks for the operator; progress and completion (good, scrap, consumed component lots) are confirmed to the ERP.</bpmn:documentation>
<bpmn:startEvent id="Start_Order" name="Order released"><bpmn:extensionElements><operaton:formData><operaton:formField id="orderId" label="Order number" type="string" defaultValue="PO-0001" /><operaton:formField id="quantity" label="Good parts to produce" type="long" defaultValue="24" /><operaton:formField id="manualContainerExchange" label="Exchange full KLTs manually (task list)" type="boolean" defaultValue="false" /><operaton:formField id="rejectRateLimit" label="Reject rate limit (0..1)" type="string" defaultValue="0.25" /></operaton:formData></bpmn:extensionElements><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent><bpmn:startEvent id="Start_OrderReleased" name="Order released by ERP"><bpmn:documentation>ERP order release (services/erp): variables orderId, material, quantity, dueDate, manualContainerExchange, rejectRateLimit.</bpmn:documentation><bpmn:outgoing>Flow_1b</bpmn:outgoing><bpmn:messageEventDefinition id="Start_OrderReleased_def" messageRef="Msg_OrderReleased" /></bpmn:startEvent><bpmn:serviceTask id="Task_StartLine" name="Start line" operaton:type="external" operaton:topic="line-start"><bpmn:documentation>Sets automatic KLT exchange, resets and starts LINE01 via the LineControl operations of the AAS and records the counter baseline.</bpmn:documentation><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:incoming>Flow_1b</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="Gw_Loop"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:incoming>Flow_Continue</bpmn:incoming><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:intermediateCatchEvent id="Timer_Poll" name="10 s"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing><bpmn:timerEventDefinition id="Timer_Poll_def"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT10S</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:intermediateCatchEvent><bpmn:serviceTask id="Task_ReadProgress" name="Read progress from AAS" operaton:type="external" operaton:topic="order-progress"><bpmn:documentation>Reads parts_ok / parts_nok of PLC01 from its OperationalData submodel and computes progress and the reject rate of the last interval.</bpmn:documentation><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="Gw_Progress" name="Order state?" default="Flow_Continue"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_Done</bpmn:outgoing><bpmn:outgoing>Flow_Rejects</bpmn:outgoing><bpmn:outgoing>Flow_Continue</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="Task_StopLine" name="Stop line" operaton:type="external" operaton:topic="line-command"><bpmn:extensionElements><operaton:inputOutput><operaton:inputParameter name="packmlCommand">Stop</operaton:inputParameter></operaton:inputOutput></bpmn:extensionElements><bpmn:incoming>Flow_Done</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="Task_CloseOrder" name="Close order" operaton:type="external" operaton:topic="order-close"><bpmn:documentation>Restores automatic KLT exchange and logs the order summary.</bpmn:documentation><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="Task_ConfirmOrder" name="Confirm order to ERP" operaton:type="external" operaton:topic="order-confirm"><bpmn:documentation>Sends the final operations performance (good quantity, scrap, consumed component lots) to the ERP. Orders the ERP does not know (manual start) are skipped; an unreachable ERP becomes an incident after the retries.</bpmn:documentation><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_7b</bpmn:outgoing></bpmn:serviceTask><bpmn:endEvent id="End_Order" name="Order completed"><bpmn:incoming>Flow_7b</bpmn:incoming></bpmn:endEvent><bpmn:serviceTask id="Task_HoldLine" name="Hold line" operaton:type="external" operaton:topic="line-command"><bpmn:extensionElements><operaton:inputOutput><operaton:inputParameter name="packmlCommand">Hold</operaton:inputParameter></operaton:inputOutput></bpmn:extensionElements><bpmn:incoming>Flow_Rejects</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing></bpmn:serviceTask><bpmn:userTask id="User_Investigate" name="Investigate reject rate" operaton:candidateGroups="operators"><bpmn:documentation>The reject rate exceeded the limit. Inspect the assembly cell and the colour sensor, then document cause and action.</bpmn:documentation><bpmn:extensionElements><operaton:formData><operaton:formField id="cause" label="Cause" type="string" /><operaton:formField id="action" label="Corrective action" type="string" /></operaton:formData></bpmn:extensionElements><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:outgoing>Flow_9</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="Task_UnholdLine" name="Unhold line" operaton:type="external" operaton:topic="line-command"><bpmn:extensionElements><operaton:inputOutput><operaton:inputParameter name="packmlCommand">Unhold</operaton:inputParameter></operaton:inputOutput></bpmn:extensionElements><bpmn:incoming>Flow_9</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing></bpmn:serviceTask><bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Order" targetRef="Task_StartLine"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_2" sourceRef="Task_StartLine" targetRef="Gw_Loop"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_3" sourceRef="Gw_Loop" targetRef="Timer_Poll"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_4" sourceRef="Timer_Poll" targetRef="Task_ReadProgress"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_5" sourceRef="Task_ReadProgress" targetRef="Gw_Progress"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_Done" name="done" sourceRef="Gw_Progress" targetRef="Task_StopLine"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${orderDone}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_Rejects" name="rejects" sourceRef="Gw_Progress" targetRef="Task_HoldLine"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!orderDone &amp;&amp; rejectAlarm}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_Continue" name="running" sourceRef="Gw_Progress" targetRef="Gw_Loop"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_6" sourceRef="Task_StopLine" targetRef="Task_CloseOrder"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_1b" sourceRef="Start_OrderReleased" targetRef="Task_StartLine"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_7" sourceRef="Task_CloseOrder" targetRef="Task_ConfirmOrder"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_7b" sourceRef="Task_ConfirmOrder" targetRef="End_Order"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_8" sourceRef="Task_HoldLine" targetRef="User_Investigate"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_9" sourceRef="User_Investigate" targetRef="Task_UnholdLine"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_10" sourceRef="Task_UnholdLine" targetRef="Gw_Loop"></bpmn:sequenceFlow><bpmn:subProcess id="Sub_ContainerFull" name="KLT full" triggeredByEvent="true"><bpmn:startEvent id="Start_ContainerFull" name="KLT full" isInterrupting="false"><bpmn:outgoing>Flow_S1</bpmn:outgoing><bpmn:messageEventDefinition id="Start_ContainerFull_def" messageRef="Msg_ContainerFull" /></bpmn:startEvent><bpmn:exclusiveGateway id="Gw_Manual" name="Manual exchange?" default="Flow_Auto"><bpmn:incoming>Flow_S1</bpmn:incoming><bpmn:outgoing>Flow_Manual</bpmn:outgoing><bpmn:outgoing>Flow_Auto</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="User_ExchangeKlt" name="Exchange KLT" operaton:candidateGroups="operators"><bpmn:documentation>KLT ${container} is full. Replace it with an empty KLT, then complete this task.</bpmn:documentation><bpmn:incoming>Flow_Manual</bpmn:incoming><bpmn:outgoing>Flow_S2</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="Task_ConfirmExchange" name="Confirm exchange to line" operaton:type="external" operaton:topic="line-exchange-container"><bpmn:incoming>Flow_S2</bpmn:incoming><bpmn:outgoing>Flow_S3</bpmn:outgoing></bpmn:serviceTask><bpmn:endEvent id="End_Exchanged" name="KLT exchanged"><bpmn:incoming>Flow_S3</bpmn:incoming></bpmn:endEvent><bpmn:endEvent id="End_Auto" name="Automatic exchange"><bpmn:incoming>Flow_Auto</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_S1" sourceRef="Start_ContainerFull" targetRef="Gw_Manual"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_Manual" name="yes" sourceRef="Gw_Manual" targetRef="User_ExchangeKlt"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${manualContainerExchange}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_Auto" name="no" sourceRef="Gw_Manual" targetRef="End_Auto"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_S2" sourceRef="User_ExchangeKlt" targetRef="Task_ConfirmExchange"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_S3" sourceRef="Task_ConfirmExchange" targetRef="End_Exchanged"></bpmn:sequenceFlow></bpmn:subProcess>
</bpmn:process>
<bpmn:message id="Msg_ContainerFull" name="ContainerFull" /><bpmn:message id="Msg_OrderReleased" name="OrderReleased" />
<bpmndi:BPMNDiagram id="Diagram_ProductionOrder"><bpmndi:BPMNPlane id="Plane_ProductionOrder" bpmnElement="ProductionOrder">
<bpmndi:BPMNShape id="Start_Order_di" bpmnElement="Start_Order"><dc:Bounds x="160" y="182" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="140" y="222" width="76" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_StartLine_di" bpmnElement="Task_StartLine"><dc:Bounds x="250" y="160" width="110" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Gw_Loop_di" bpmnElement="Gw_Loop" isMarkerVisible="true"><dc:Bounds x="410" y="175" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Timer_Poll_di" bpmnElement="Timer_Poll"><dc:Bounds x="510" y="182" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="490" y="222" width="76" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_ReadProgress_di" bpmnElement="Task_ReadProgress"><dc:Bounds x="600" y="160" width="110" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Gw_Progress_di" bpmnElement="Gw_Progress" isMarkerVisible="true"><dc:Bounds x="760" y="175" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="700" y="232" width="90" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_StopLine_di" bpmnElement="Task_StopLine"><dc:Bounds x="870" y="160" width="110" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_CloseOrder_di" bpmnElement="Task_CloseOrder"><dc:Bounds x="1030" y="160" width="110" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_ConfirmOrder_di" bpmnElement="Task_ConfirmOrder"><dc:Bounds x="1190" y="160" width="110" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="End_Order_di" bpmnElement="End_Order"><dc:Bounds x="1350" y="182" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1330" y="222" width="76" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_HoldLine_di" bpmnElement="Task_HoldLine"><dc:Bounds x="870" y="290" width="110" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="User_Investigate_di" bpmnElement="User_Investigate"><dc:Bounds x="1030" y="290" width="110" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_UnholdLine_di" bpmnElement="Task_UnholdLine"><dc:Bounds x="1190" y="290" width="110" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="196" y="200" /><di:waypoint x="250" y="200" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="360" y="200" /><di:waypoint x="410" y="200" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="460" y="200" /><di:waypoint x="510" y="200" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4"><di:waypoint x="546" y="200" /><di:waypoint x="600" y="200" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5"><di:waypoint x="710" y="200" /><di:waypoint x="760" y="200" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_Done_di" bpmnElement="Flow_Done"><di:waypoint x="810" y="200" /><di:waypoint x="870" y="200" /><bpmndi:BPMNLabel><dc:Bounds x="816" y="182" width="60" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_Rejects_di" bpmnElement="Flow_Rejects"><di:waypoint x="785" y="225" /><di:waypoint x="785" y="330" /><di:waypoint x="870" y="330" /><bpmndi:BPMNLabel><dc:Bounds x="791" y="207" width="60" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_Continue_di" bpmnElement="Flow_Continue"><di:waypoint x="785" y="175" /><di:waypoint x="785" y="120" /><di:waypoint x="435" y="120" /><di:waypoint x="435" y="175" /><bpmndi:BPMNLabel><dc:Bounds x="791" y="157" width="60" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6"><di:waypoint x="980" y="200" /><di:waypoint x="1030" y="200" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7"><di:waypoint x="1140" y="200" /><di:waypoint x="1190" y="200" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_7b_di" bpmnElement="Flow_7b"><di:waypoint x="1300" y="200" /><di:waypoint x="1350" y="200" /></bpmndi:BPMNEdge><bpmndi:BPMNShape id="Start_OrderReleased_di" bpmnElement="Start_OrderReleased"><dc:Bounds x="160" y="282" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="135" y="322" width="86" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNEdge id="Flow_1b_di" bpmnElement="Flow_1b"><di:waypoint x="196" y="300" /><di:waypoint x="305" y="300" /><di:waypoint x="305" y="240" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8"><di:waypoint x="980" y="330" /><di:waypoint x="1030" y="330" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9"><di:waypoint x="1140" y="330" /><di:waypoint x="1190" y="330" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10"><di:waypoint x="1245" y="370" /><di:waypoint x="1245" y="400" /><di:waypoint x="435" y="400" /><di:waypoint x="435" y="225" /></bpmndi:BPMNEdge><bpmndi:BPMNShape id="Start_ContainerFull_di" bpmnElement="Start_ContainerFull"><dc:Bounds x="240" y="512" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="220" y="552" width="76" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="Gw_Manual_di" bpmnElement="Gw_Manual" isMarkerVisible="true"><dc:Bounds x="330" y="505" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="305" y="470" width="90" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="User_ExchangeKlt_di" bpmnElement="User_ExchangeKlt"><dc:Bounds x="440" y="490" width="110" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_ConfirmExchange_di" bpmnElement="Task_ConfirmExchange"><dc:Bounds x="600" y="490" width="110" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="End_Exchanged_di" bpmnElement="End_Exchanged"><dc:Bounds x="760" y="512" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="740" y="552" width="76" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="End_Auto_di" bpmnElement="End_Auto"><dc:Bounds x="440" y="602" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="420" y="642" width="76" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="Sub_ContainerFull_di" bpmnElement="Sub_ContainerFull" isExpanded="true"><dc:Bounds x="200" y="450" width="760" height="230" /></bpmndi:BPMNShape><bpmndi:BPMNEdge id="Flow_S1_di" bpmnElement="Flow_S1"><di:waypoint x="276" y="530" /><di:waypoint x="330" y="530" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_Manual_di" bpmnElement="Flow_Manual"><di:waypoint x="380" y="530" /><di:waypoint x="440" y="530" /><bpmndi:BPMNLabel><dc:Bounds x="386" y="512" width="60" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_Auto_di" bpmnElement="Flow_Auto"><di:waypoint x="355" y="555" /><di:waypoint x="355" y="620" /><di:waypoint x="440" y="620" /><bpmndi:BPMNLabel><dc:Bounds x="361" y="537" width="60" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_S2_di" bpmnElement="Flow_S2"><di:waypoint x="550" y="530" /><di:waypoint x="600" y="530" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_S3_di" bpmnElement="Flow_S3"><di:waypoint x="710" y="530" /><di:waypoint x="760" y="530" /></bpmndi:BPMNEdge>
</bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>
