        unit="s" description="Switching delay (filter) for both edges"/>
    <Boolean name="dark_on" valueReference="11" causality="parameter" variability="fixed" start="true"
        description="true: output is active while the beam is interrupted"/>
    <Float64 name="rated_power" valueReference="12" causality="parameter" variability="fixed" start="1.2"
        unit="W"/>
    <Int32 name="seed" valueReference="13" causality="parameter" variability="fixed" start="11"
        description="Random seed of the beam dropouts (deterministic runs)"/>
    <Float64 name="dropout_rate" valueReference="14" causality="parameter" variability="fixed" start="1.5"
        unit="1/s" description="Mean beam dropouts per second at misalignment 1 (scaled linearly below 1)"/>
    <Float64 name="dropout_duration" valueReference="15" causality="parameter" variability="fixed" start="0.06"
        unit="s" description="Duration of one beam dropout"/>
    <Boolean name="signal" valueReference="20" causality="output" variability="discrete" initial="exact"
        start="false" description="Switching output (PNP)"/>
    <Int32 name="switch_count" valueReference="21" causality="output" variability="discrete" initial="exact"
        start="0" description="Number of activations since start"/>
    <Float64 name="power" valueReference="22" causality="output" variability="continuous" initial="exact"
        start="0" unit="W"/>
    <Float64 name="energy" valueReference="23" causality="output" variability="continuous" initial="exact"
        start="0" unit="kWh"/>
    <Float64 name="operating_hours" valueReference="24" causality="output" variability="continuous"
        initial="exact" start="0" unit="h"/>
    <Boolean name="stability_ok" valueReference="25" causality="output" variability="discrete" initial="exact"
        start="true" description="Excess-gain diagnostics (IO-Link): false when the received light is marginal (misalignment &gt;= 0.2)"/>
  </ModelVariables>
  <ModelStructure>
    <Output valueReference="20"/>
    <Output valueReference="21"/>
    <Output valueReference="22"/>
    <Output valueReference="23"/>
    <Output valueReference="24"/>
    <Output valueReference="25"/>
  </ModelStructure>
</fmiModelDescription>
