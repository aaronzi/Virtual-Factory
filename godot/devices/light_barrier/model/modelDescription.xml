<?xml version="1.0" encoding="UTF-8"?>
<fmiModelDescription fmiVersion="3.0" modelName="LightBarrier"
    instantiationToken="{6f1d2a90-1b7e-4c55-9d8e-0a1b2c3d4e01}"
    description="Retro-reflective photoelectric sensor with response-time filter and dark/light-on logic, misalignment injection"
    generationTool="Virtual Factory" version="1.0.0">
  <CoSimulation modelIdentifier="light_barrier" canHandleVariableCommunicationStepSize="true"
      canGetAndSetFMUState="true"/>
  <UnitDefinitions>
    <Unit name="s"><BaseUnit s="1"/></Unit>
    <Unit name="W"><BaseUnit kg="1" m="2" s="-3"/></Unit>
    <Unit name="kWh"><BaseUnit kg="1" m="2" s="-2" factor="3600000"/></Unit>
    <Unit name="h"><BaseUnit s="1" factor="3600"/></Unit>
    <Unit name="1/s"><BaseUnit s="-1"/></Unit>
  </UnitDefinitions>
  <DefaultExperiment stepSize="0.0166666666666667"/>
  <ModelVariables>
    <Float64 name="time" valueReference="0" causality="independent" variability="continuous" unit="s"/>
