{
  "_doc": "Unified Namespace (UNS) registry of the shop floor - single source for the Godot UNS gateway, the AAS Asset Interfaces Description (provisioner), the AIMC bridge, the MES and the ops gateway. ISA-95 path enterprise/site/area/line. Reference: docs/interfaces/uns.md",
  "broker": {
    "base": "mqtt://localhost:1883",
    "websocket": "ws://localhost:9001"
  },
  "topic_root": "vf/plant01/final-assembly/line01",
  "payload": {
    "content_type": "application/json",
    "value_key": "v",
    "timestamp_key": "ts"
  },
  "session": {
    "topic": "{root}/session",
    "status_topic": "{root}/status",
    "retain": true,
    "qos": 1
  },
  "telemetry": {
    "topic": "{root}/{device}/{variable}",
    "retain": true,
    "qos": 0,
    "min_interval_s": 0.1
  },
  "events": {
    "topic": "{root}/{device}/event/{event}",
    "retain": false,
    "qos": 1,
    "definitions": [
      {
        "device": "AC01", "event": "part_released", "trigger": "AC01.release_count",
        "description": "A finished cylinder left the assembly cell onto the conveyor (cell test data and component lots included)",
        "fields": {
          "serial": "AC01.last_serial", "cap_variant": "AC01.last_cap_variant",
          "leak_rate": "AC01.last_leak_rate", "stroke_time": "AC01.last_stroke_time",
          "lots": "AC01.last_lots"
        }
      },
      {
        "device": "PLC01", "event": "part_inspected", "trigger": "PLC01.parts_total",
        "description": "The colour inspection of a part at QS01 is complete (result latched by the PLC)",
        "fields": {
          "serial": "PLC01.serial_at_qs", "result": "PLC01.last_result",
          "r": "QS01.r", "g": "QS01.g", "b": "QS01.b", "hue": "QS01.hue", "delta_e": "QS01.delta_e"
        }
      },
      {
        "device": "PLC01", "event": "part_sorted", "trigger": "PLC01.sorted_count",
        "description": "The robot placed a part into a KLT (1 = KLT A good parts, 2 = KLT B rejects)",
        "fields": {
          "serial": "PLC01.sorted_serial", "container": "PLC01.sorted_target", "slot": "PLC01.sorted_slot"
        }
      },
      {
        "device": "KLTA01", "event": "container_full", "trigger": "KLTA01.full", "when": true,
        "description": "KLT A is full and must be exchanged",
        "fields": {"fill_count": "KLTA01.fill_count"}
      },
      {
        "device": "KLTB01", "event": "container_full", "trigger": "KLTB01.full", "when": true,
        "description": "KLT B is full and must be exchanged",
        "fields": {"fill_count": "KLTB01.fill_count"}
      },
      {
        "device": "KLTA01", "event": "container_exchanged", "trigger": "KLTA01.exchange_count",
        "description": "An empty KLT replaced the full one at station KLTA01",
        "fields": {"exchange_count": "KLTA01.exchange_count"}
      },
      {
        "device": "KLTB01", "event": "container_exchanged", "trigger": "KLTB01.exchange_count",
        "description": "An empty KLT replaced the full one at station KLTB01",
        "fields": {"exchange_count": "KLTB01.exchange_count"}
      }
    ]
  },
  "commands": {
    "topic": "{root}/{device}/cmd/{variable}",
    "ack_topic": "{root}/{device}/cmd-resp/{variable}",
    "retain": false,
    "qos": 1,
    "writable": {
      "PLC01": ["packml_command", "klt_exchange_command", "auto_exchange", "unit_mode_command"],
      "AC01": ["defect_rate_missing_cap", "defect_rate_wrong_cap"],
      "CV01": ["motor_fault"],
      "LB01": ["misalignment"],
      "LB02": ["misalignment"],
      "QS01": ["contamination", "drift"],
      "RB01": ["protective_stop", "finger_wear_rate", "gripper_maintenance_reset"]
    },
    "pulse": ["PLC01.packml_command", "PLC01.klt_exchange_command", "PLC01.unit_mode_command",
              "RB01.gripper_maintenance_reset"]
  },
  "maintenance": {
    "_doc": "Condition monitoring results of the maintenance service (ADR-0029), published like telemetry ({\"v\", \"ts\"}, retained) and recorded by the historian in table 'maintenance' (tags session, component). {component} = monitored component tag in lower case (gr01). alarm_topic carries the alarm word of the advisory maintenance alarms (codes of infra/alarms.json with source MAINTENANCE), read by the alarms service like PLC01.active_alarms.",
    "topic": "{root}/maintenance/{component}/{indicator}",
    "alarm_topic": "{root}/maintenance/active_alarms",
    "retain": true,
    "qos": 1,
    "indicators": {
      "health_index": "Float64", "wear": "Float64", "rul_cycles": "Float64", "rul_cycles_low": "Float64",
      "rul_hours": "Float64", "rul_hours_low": "Float64", "confidence": "Float64", "throughput": "Float64",
      "health_state": "String", "order": "String"
    }
  },
  "opcua": {
    "_doc": "OT path of controllers with an OPC UA server (ADR-0024). enabled: the Godot UNS gateway leaves the telemetry, events and commands of these devices to the OPC UA path (simulated CPU -> backplane -> communication module plc-comm -> OPC UA -> edge connector -> UNS); false (or --vf-backplane=off): Godot publishes them directly as before. packml_tags/packml_commands map FMI variables onto the OPC 30050 PackML structure of the address space; all other FMI variables appear under Program (docs/interfaces/uns.md).",
    "enabled": true,
    "servers": {
      "PLC01": {
        "endpoint": "opc.tcp://localhost:4840/vf/plc01",
        "namespace": "urn:virtual-factory:plant01:line01:plc01",
        "backplane": "tcp://localhost:4841",
        "publishing_interval_ms": 100,
        "packml_tags": {
          "Status.StateCurrent": "packml_state", "Status.UnitModeCurrent": "unit_mode",
          "Status.MachSpeed": "belt_speed", "Status.CurMachSpeed": "cv_speed_setpoint",
          "Admin.ProdProcessedCount": "parts_total", "Admin.ProdGoodCount": "parts_ok",
          "Admin.ProdDefectiveCount": "parts_nok", "Admin.AlarmCode": "alarm_code",
          "Admin.AlarmText": "alarm_text", "Admin.AlarmCount": "alarm_count"
        },
        "packml_commands": {"BaseStateMachine": "packml_command", "SetUnitMode": "unit_mode_command"}
      }
    }
  }
}
