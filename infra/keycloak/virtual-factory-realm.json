{
  "realm": "virtual-factory",
  "displayName": "Virtual Factory (training, local defaults)",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 3600,
  "oauth2DeviceCodeLifespan": 600,
  "oauth2DevicePollingInterval": 5,
  "roles": {
    "realm": [
      {
        "name": "operator",
        "description": "Line operator - reads the line AAS, invokes LineControl, acknowledges alarms"
      },
      {
        "name": "quality",
        "description": "Quality engineer - reads the line AAS, passports and quality data"
      },
      {
        "name": "maintenance",
        "description": "Maintenance technician - condition monitoring, maintenance windows, LineControl Maintain"
      },
      {
        "name": "planner",
        "description": "Production planner (ERP) - orders, maintenance windows, LineControl"
      },
      {
        "name": "auditor",
        "description": "Auditor - reads everything (AAS, passports, supplier batches), writes nothing"
      },
      {
        "name": "authority",
        "description": "Market surveillance authority - extended passport (composition, BoM, technical, quality data)"
      },
      {
        "name": "recycler",
        "description": "Recycler / repairer - extended passport (composition, circularity, BoM)"
      },
      {
        "name": "public",
        "description": "Public passport sections only (same as an anonymous request)"
      },
      {
        "name": "svc-mes",
        "description": "Service account: Workpiece AAS and passports, BPMN workers"
      },
      {
        "name": "svc-bridge",
        "description": "Service account: AIMC bridge (UNS -> AAS)"
      },
      {
        "name": "svc-ops-gateway",
        "description": "Service account: Delegated AAS operations"
      },
      {
        "name": "svc-sustainability",
