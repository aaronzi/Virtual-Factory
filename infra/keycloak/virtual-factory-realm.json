      },
      {
        "name": "svc-erp",
        "description": "Service account: ERP simulator"
      },
      {
        "name": "svc-alarms",
        "description": "Service account: Alarms and events"
      },
      {
        "name": "svc-maintenance",
        "description": "Service account: Predictive maintenance"
      },
      {
        "name": "svc-supplier",
        "description": "Service account: Supplier portal (supplier environment)"
      },
      {
        "name": "svc-edge",
        "description": "Service account: OPC UA edge connector"
      },
      {
        "name": "svc-resolver",
        "description": "Service account: GS1 Digital Link resolver (acts for the public)"
      }
