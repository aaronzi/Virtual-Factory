  {
   "type": "table",
   "title": "Maintenance alarms (ISA-18.2)",
   "description": "Advisory alarm 901 (maintenance service) and robot fault 202 from the alarm journal of the alarms service",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "vf-alarms"
   },
   "gridPos": {
    "x": 0,
    "y": 21,
    "w": 14,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "vf-alarms"
     },
     "rawSql": "SELECT j.time AS \"Time\", j.code AS \"Code\", j.event AS \"Event\", j.state AS \"State\", d.priority AS \"Priority\", d.text_en AS \"Alarm\", j.operator AS \"Operator\" FROM alarm_journal j JOIN alarm_definition d USING (code) WHERE j.code IN (901, 202) AND $__timeFilter(j.time) ORDER BY j.time DESC LIMIT 50",
     "format": "table",
     "rawQuery": true,
     "editorMode": "code"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "showHeader": true
   },
   "id": 10
  },
