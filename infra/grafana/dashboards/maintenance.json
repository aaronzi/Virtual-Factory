  {
   "type": "timeseries",
   "title": "Grip force and closing time",
   "description": "Symptoms: clamping force at the last grip (left axis) and closing time of the jaws (right axis)",
   "datasource": {
    "type": "influxdb",
    "uid": "vf-historian"
   },
   "gridPos": {
    "x": 12,
