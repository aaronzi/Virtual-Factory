 "panels": [
  {
   "type": "stat",
   "title": "Health index GR01",
   "description": "Gripper fingers GR01: 1 - finger wear / wear limit (maintenance service, ADR-0029)",
   "datasource": {
    "type": "influxdb",
    "uid": "vf-historian"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 5,
    "h": 5
