 "templating": {
  "list": [
   {
    "datasource": {
     "type": "influxdb",
     "uid": "vf-historian"
    },
    "includeAll": false,
    "multi": false,
    "sort": 0,
    "regex": "",
    "skipUrlSync": false,
    "options": [],
    "name": "session",
    "label": "Session",
    "type": "query",
    "refresh": 2,
    "hide": 0,
    "description": "UNS session (one per Godot start); 'latest' follows the newest session",
    "query": {
     "query": "SELECT 'latest' AS session UNION ALL SELECT session FROM (SELECT DISTINCT session FROM plc01) ORDER BY session = 'latest' DESC, session DESC",
     "refId": "session"
    },
    "current": {
     "selected": true,
     "text": "latest",
     "value": "latest"
    }
   },
   {
    "datasource": {
     "type": "influxdb",
     "uid": "vf-historian"
    },
    "includeAll": false,
    "multi": false,
    "sort": 0,
    "regex": "",
    "skipUrlSync": false,
    "options": [],
    "name": "sid",
    "label": "Session id",
    "type": "query",
    "refresh": 2,
    "hide": 2,
    "description": "Resolved session id ('latest' -> newest session)",
    "query": {
     "query": "SELECT CASE WHEN '${session}' = 'latest' THEN max(session) ELSE '${session}' END AS sid FROM plc01",
     "refId": "sid"
    },
    "current": {}
   }
  ]
 },
