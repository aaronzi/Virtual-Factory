   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "influxdb",
      "uid": "vf-historian"
     },
     "rawSql": "SELECT health_index AS \"Health index\" FROM maintenance WHERE component = 'GR01' AND session = '${sid}' AND health_index IS NOT NULL ORDER BY time DESC LIMIT 1",
     "format": "table",
     "rawQuery": true,
     "editorMode": "code"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "color": {
