  {
   "type": "timeseries",
   "title": "Health index",
   "description": "Health index of the gripper fingers over time; the maintenance order is opened when the RUL lower bound falls below the threshold (8 h) while HI < 0.85, at the latest at HI < 0.25",
   "datasource": {
    "type": "influxdb",
    "uid": "vf-historian"
   },
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "influxdb",
      "uid": "vf-historian"
     },
     "rawSql": "SELECT time, health_index AS \"Health index\" FROM maintenance WHERE component = 'GR01' AND session = '${sid}' AND $__timeFilter(time) AND health_index IS NOT NULL ORDER BY time",
     "format": "table",
     "rawQuery": true,
     "editorMode": "code"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 10,
      "spanNulls": true,
      "showPoints": "auto",
      "thresholdsStyle": {
       "mode": "line+area"
      }
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "transparent",
        "value": 0.25
       }
      ]
     },
     "color": {
      "mode": "palette-classic"
     },
     "min": 0,
     "max": 1
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "showLegend": true,
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "id": 6
  },
  {
   "type": "timeseries",
   "title": "Remaining useful life (grips)",
   "description": "Median and 90 % lower bound of the remaining grips until the wear limit (TrendFit; DesignRate shows the design life)",
   "datasource": {
    "type": "influxdb",
    "uid": "vf-historian"
   },
   "gridPos": {
    "x": 12,
    "y": 5,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "influxdb",
      "uid": "vf-historian"
     },
     "rawSql": "SELECT time, rul_cycles AS \"median\", rul_cycles_low AS \"lower bound\" FROM maintenance WHERE component = 'GR01' AND session = '${sid}' AND $__timeFilter(time) AND rul_cycles IS NOT NULL AND rul_cycles < 1000 ORDER BY time",
     "format": "table",
     "rawQuery": true,
     "editorMode": "code"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "custom": {
      "drawStyle": "line",
