    {
     "refId": "A",
     "datasource": {
      "type": "influxdb",
      "uid": "vf-historian"
     },
     "rawSql": "SELECT time, finger_wear * 1000 AS \"finger wear\" FROM rb01 WHERE session = '${sid}' AND $__timeFilter(time) AND finger_wear IS NOT NULL ORDER BY time",
     "format": "table",
     "rawQuery": true,
     "editorMode": "code"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "lengthmm",
     "custom": {
