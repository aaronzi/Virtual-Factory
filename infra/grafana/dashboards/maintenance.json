     "rawSql": "SELECT time, grip_force AS \"grip force\", grip_close_time AS \"closing time\" FROM rb01 WHERE session = '${sid}' AND $__timeFilter(time) AND grip_force IS NOT NULL ORDER BY time",
     "format": "table",
     "rawQuery": true,
     "editorMode": "code"
    }
   ],
   "fieldConfig": {
