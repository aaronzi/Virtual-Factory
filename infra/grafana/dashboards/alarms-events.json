     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "vf-alarms"
     },
     "rawSql": "SELECT count(*) FILTER (WHERE state IN ('SHLVD', 'DSUPR')) AS \"Hidden\" FROM alarm_state",
     "format": "table",
