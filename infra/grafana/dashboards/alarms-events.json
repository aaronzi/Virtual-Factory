   }
  },
  {
   "id": 11,
   "type": "table",
   "title": "Chattering and standing alarms",
   "description": "Chattering: >= 3 activations within 60 s; standing: active now with duration",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "vf-alarms"
   },
   "gridPos": {
    "x": 14,
    "y": 12,
    "w": 10,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "vf-alarms"
     },
     "rawSql": "SELECT code AS \"Code\", 'chattering' AS \"Finding\", max(n) || ' activations in 60 s' AS \"Detail\" FROM (SELECT code, count(*) OVER (PARTITION BY code ORDER BY activated_at RANGE BETWEEN INTERVAL '60 seconds' PRECEDING AND CURRENT ROW) AS n FROM alarm_occurrence WHERE $__timeFilter(activated_at)) x GROUP BY code HAVING max(n) >= 3 UNION ALL SELECT code, CASE WHEN now() - activated_at > INTERVAL '1 hour' THEN 'stale' ELSE 'standing' END, 'active for ' || date_trunc('second', now() - activated_at)::text FROM alarm_state WHERE active ORDER BY 1",
     "format": "table",
     "rawQuery": true,
     "editorMode": "code"
    }
   ]
  },
  {
   "id": 12,
   "type": "table",
   "title": "Alarm journal",
   "description": "Alarm transitions (ACTIVATED, ACKNOWLEDGED, CLEARED, SHELVED, ...) in the selected range, newest first",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "vf-alarms"
   },
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 12,
    "h": 10
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "vf-alarms"
     },
     "rawSql": "SELECT j.time AS \"Time\", j.code AS \"Code\", j.event AS \"Event\", j.state AS \"State\", j.priority AS \"Priority\", j.annunciated AS \"Annunciated\", j.operator AS \"Operator\", d.text_en AS \"Alarm\" FROM alarm_journal j LEFT JOIN alarm_definition d USING (code) WHERE $__timeFilter(j.time) ORDER BY j.time DESC LIMIT 500",
     "format": "table",
     "rawQuery": true,
     "editorMode": "code"
    }
   ]
  },
  {
   "id": 13,
   "type": "table",
   "title": "Event journal (UNS)",
   "description": "UNS events, commands, acknowledgements, PackML state changes and session births, newest first",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "vf-alarms"
   },
   "gridPos": {
    "x": 12,
    "y": 20,
    "w": 12,
    "h": 10
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "vf-alarms"
     },
     "rawSql": "SELECT time AS \"Time\", kind AS \"Kind\", device AS \"Device\", name AS \"Name\", seq AS \"Seq\", payload::text AS \"Payload\" FROM event_journal WHERE $__timeFilter(time) ORDER BY time DESC LIMIT 500",
     "format": "table",
     "rawQuery": true,
     "editorMode": "code"
    }
   ]
  },
  {
   "id": 14,
   "type": "timeseries",
   "title": "Events per minute",
   "description": "UNS event journal by kind",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "vf-alarms"
   },
   "gridPos": {
    "x": 0,
    "y": 30,
    "w": 24,
    "h": 6
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "vf-alarms"
     },
     "rawSql": "SELECT $__timeGroupAlias(time, '1m', 0), kind AS metric, count(*) AS value FROM event_journal WHERE $__timeFilter(time) GROUP BY 1, 2 ORDER BY 1",
     "format": "time_series",
     "rawQuery": true,
     "editorMode": "code"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 60,
      "stacking": {
       "mode": "normal"
      }
     },
     "decimals": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "showLegend": true,
     "placement": "bottom",
     "displayMode": "list"
    }
   }
  }
 ]
