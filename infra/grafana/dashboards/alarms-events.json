  {
   "id": 1,
   "type": "stat",
   "title": "Standing alarms",
   "description": "Alarms active now (ISA-18.2 standing alarms; stale = active longer than 1 h)",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "vf-alarms"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "vf-alarms"
     },
     "rawSql": "SELECT count(*) AS \"Standing\" FROM alarm_state WHERE active",
     "format": "table",
     "rawQuery": true,
     "editorMode": "code"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 0,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
