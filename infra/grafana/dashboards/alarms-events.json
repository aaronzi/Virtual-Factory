  {
   "id": 4,
   "type": "stat",
   "title": "Alarms last 10 min",
   "description": "Annunciated alarms in the last 10 minutes (EEMUA 191: > 10 = flood)",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "vf-alarms"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "vf-alarms"
     },
     "rawSql": "SELECT count(*) AS \"Last 10 min\" FROM alarm_occurrence WHERE annunciated AND activated_at > now() - INTERVAL '10 minutes'",
     "format": "table",
     "rawQuery": true,
     "editorMode": "code"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 0,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 2
       },
       {
        "color": "red",
        "value": 10
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center"
   }
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Average per 10 min",
   "description": "Annunciated alarms per 10 minutes over the selected range (EEMUA 191: <= 1 very likely acceptable, <= 2 manageable)",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "vf-alarms"
   },
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "vf-alarms"
     },
     "rawSql": "SELECT count(*)::float / greatest(1, extract(epoch FROM ($__timeTo()::timestamptz - $__timeFrom()::timestamptz)) / 600) AS \"Per 10 min\" FROM alarm_occurrence WHERE annunciated AND $__timeFilter(activated_at)",
     "format": "table",
     "rawQuery": true,
     "editorMode": "code"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 2,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 1
       },
       {
        "color": "orange",
        "value": 2
       },
       {
        "color": "red",
        "value": 10
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center"
   }
  },
  {
   "id": 6,
   "type": "stat",
   "title": "Mean time to acknowledge",
   "description": "Average time from activation to acknowledgement in the selected range",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "vf-alarms"
   },
   "gridPos": {
    "x": 20,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "vf-alarms"
     },
     "rawSql": "SELECT avg(extract(epoch FROM acked_at - activated_at)) AS \"MTTA\" FROM alarm_occurrence WHERE acked_at IS NOT NULL AND $__timeFilter(activated_at)",
     "format": "table",
     "rawQuery": true,
     "editorMode": "code"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "decimals": 1,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 60
       },
       {
        "color": "red",
        "value": 300
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center"
   }
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Annunciated alarms per 10 minutes",
   "description": "Alarm rate per operator position (ISA-18.2 / EEMUA 191 benchmark lines at 1 and 10)",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "vf-alarms"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "vf-alarms"
     },
     "rawSql": "SELECT $__timeGroupAlias(activated_at, '10m', 0), count(*) AS \"Alarms\" FROM alarm_occurrence WHERE annunciated AND $__timeFilter(activated_at) GROUP BY 1 ORDER BY 1",
     "format": "time_series",
     "rawQuery": true,
     "editorMode": "code"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 70,
      "barAlignment": -1,
      "thresholdsStyle": {
       "mode": "line+area"
      }
     },
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 1
       },
       {
        "color": "red",
        "value": 10
       }
      ]
     },
     "decimals": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "showLegend": false
    },
    "tooltip": {
     "mode": "single"
    }
   }
  },
  {
   "id": 8,
   "type": "table",
   "title": "Current alarms",
   "description": "Alarms not in NORM, most urgent first (state per ISA-18.2: UNACK, ACKED, RTNUN, SHLVD, DSUPR)",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "vf-alarms"
   },
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "vf-alarms"
     },
     "rawSql": "SELECT s.code AS \"Code\", d.priority AS \"Priority\", s.state AS \"State\", d.text_en AS \"Alarm\", s.activated_at AS \"Activated\", s.acked_by AS \"Acknowledged by\", s.shelved_until AS \"Shelved until\" FROM alarm_state s JOIN alarm_definition d USING (code) WHERE s.state <> 'NORM' ORDER BY d.priority_rank, s.activated_at DESC",
     "format": "table",
     "rawQuery": true,
     "editorMode": "code"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "State"
      },
      "properties": [
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background"
        }
       },
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "UNACK": {
            "color": "red",
            "index": 0
           },
           "RTNUN": {
            "color": "orange",
            "index": 1
           },
           "ACKED": {
            "color": "yellow",
            "index": 2
           },
           "SHLVD": {
            "color": "blue",
            "index": 3
           },
           "DSUPR": {
            "color": "purple",
            "index": 4
           }
          }
         }
        ]
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Code"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 60
       }
      ]
     }
    ]
   }
  },
  {
   "id": 9,
   "type": "bargauge",
   "title": "Top 10 bad actors",
   "description": "Alarms with the most activations in the selected range (EEMUA 191: the top 10 often cause most of the load)",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "vf-alarms"
   },
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "vf-alarms"
     },
     "rawSql": "SELECT d.code || ' ' || d.text_en AS \"Alarm\", count(*) AS \"Activations\" FROM alarm_occurrence o JOIN alarm_definition d USING (code) WHERE $__timeFilter(o.activated_at) GROUP BY d.code, d.text_en ORDER BY 2 DESC LIMIT 10",
     "format": "table",
     "rawQuery": true,
     "editorMode": "code"
    }
   ],
   "options": {
    "orientation": "horizontal",
    "displayMode": "basic",
    "showUnfilled": true,
    "reduceOptions": {
     "calcs": [],
     "fields": "",
     "values": true
    }
   },
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "continuous-YlRd"
     },
     "min": 0,
     "decimals": 0
    },
    "overrides": []
   }
  },
  {
   "id": 10,
   "type": "piechart",
   "title": "Priority distribution",
   "description": "Activations per priority in the selected range (guideline about 80 % Low, 15 % Medium, 5 % High/Critical)",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "vf-alarms"
   },
   "gridPos": {
    "x": 8,
    "y": 12,
    "w": 6,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "vf-alarms"
     },
     "rawSql": "SELECT d.priority AS \"Priority\", count(*) AS \"Activations\" FROM alarm_occurrence o JOIN alarm_definition d USING (code) WHERE $__timeFilter(o.activated_at) GROUP BY d.priority, d.priority_rank ORDER BY d.priority_rank",
     "format": "table",
     "rawQuery": true,
     "editorMode": "code"
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [],
